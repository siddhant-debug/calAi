# Copy this file to .env and fill in real values. Never commit .env itself.

# Required (ADR-006): NVIDIA NIM API key for the chat LLM provider
# (calai_backend/providers/llm.py). Get one at https://build.nvidia.com.
# There is no local-model fallback anymore — the backend cannot serve any
# LLM-dependent route (/api/agent, /api/parse-meal) without this set.
NVIDIA_API_KEY=

# Optional — max ReAct-loop tool-call iterations (legacy path only, see
# calai_backend/config.py). Default: 8.
MAX_STEPS=8

# Optional — "true" (default) routes /api/agent through the deterministic
# Orchestrator; "false" rolls back to the legacy ReAct loop. See ADR-003.
USE_ORCHESTRATOR=true
